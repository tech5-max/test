# ---- Targets ----
# fast-dragon base, everything before /api. Stage: https://api.ozak.dev
# (local fast-dragon from Docker k6: http://host.docker.internal:5555;
#  behind the load-test nginx LB: http://host.docker.internal:8080)
TARGET_BASE_URL=https://api.ozak.dev

# express-guardian base. Leave EMPTY to test fast-dragon only.
# (local: http://host.docker.internal:5001; behind the LB: http://host.docker.internal:8081)
GUARDIAN_BASE_URL=

# Session cookie replayed on every request, so gated fast-dragon + all
# express-guardian reads work. Copy it from a logged-in browser (DevTools →
# Application → Cookies), e.g.  siwe-token=eyJ...  . Empty = logged-out only
# (express-guardian endpoints are then skipped).
COOKIE=

# ---- Combo label ----
# Picks the report sub-folder only (reports/<combo>/...). It does NOT change the
# server — you restart eon into each state yourself, then run with the matching
# label. Use the 4 canonical labels so consolidate.sh orders them:
#   single-cache-on  single-cache-off  multi-cache-on  multi-cache-off
COMBO=single-cache-on

# true = also hit the AI analysis APIs (fundamental, technical, whale, demo portfolio).
# Keep OFF for cache-off combos (those routes need the cache / cost paid upstream).
INCLUDE_AI_ANALYSIS=false

# Set true on cache-off runs. It force-excludes the AI + portfolio group even if
# INCLUDE_AI_ANALYSIS=true, so those paid/uncached routes are never hit with the
# cache off. Leave false (or unset) when the server cache is on.
CACHE_OFF=false

# ---- Mode ----
# load   = a fixed rate for DURATION; report shows how the server handles that rate
# stress = load keeps growing until the server can't serve; report shows
#          🟢 easily serves / 🟡 under stress but survives / 🔴 critical (crash point)
TEST_MODE=stress

# ---- load mode ----
# Requests PER MINUTE, spread evenly (1000 = ~16.7 req/s, NOT 1000 per second)
REQUESTS_PER_MINUTE=1000
# Optional: requests per second; overrides REQUESTS_PER_MINUTE when set
REQUESTS_PER_SECOND=
DURATION=2m

# ---- stress mode ----
# Step 1 sends STRESS_START_REQUESTS in STRESS_STEP_SECONDS; every next step adds
# STRESS_STEP_REQUESTS more (500, 1000, 1500 … requests per 10s = 50, 100, 150 … req/s).
# Parallel users (VUs) grow automatically. Slow responses never stop the run;
# it stops ONLY when the server fails HTTP 500+ only on more than
# CRITICAL_ERROR_RATE of a step's requests, or after STRESS_MAX_DURATION.
STRESS_START_REQUESTS=500
STRESS_STEP_REQUESTS=500
STRESS_STEP_SECONDS=10
STRESS_MAX_DURATION=30m

# ---- Stages (rated per step) ----
# 🟢 Easily serves:             errors <= HEALTHY_ERROR_RATE and p95 <= HEALTHY_P95_MS
# 🔴 Critical (server crash):    HTTP 500+ (timeouts/resets do not count) on more than CRITICAL_ERROR_RATE
#                                of requests (0 = stop at the very first one)
# 🟡 Under stress but survives:  anything in between (slow, a few other errors)
HEALTHY_ERROR_RATE=0.01
HEALTHY_P95_MS=2000
CRITICAL_ERROR_RATE=0.01

# ---- Load generator ----
PRE_ALLOCATED_VUS=500
MAX_VUS=5000
REQUEST_TIMEOUT=15s
AI_REQUEST_TIMEOUT=60s

# ---- Output ----
# HEADLESS=true (servers/CI): a status line every MONITOR_EVERY seconds instead of
# k6's progress bar, and no browser. Leave empty to detect it automatically.
HEADLESS=
MONITOR_EVERY=10
# Log sample failing requests (first 3 workers, max once per 10s each)
LOG_ERRORS=true
# Live view in the browser (req/s, req/min, virtual users, p95/p99, errors, stage)
LIVE_UI=true
# Open the live view automatically when the test starts
LIVE_UI_OPEN=true
# Port of k6's live metrics stream (the live view reads it)
DASHBOARD_PORT=5665
