# DDoS-resilience flood test. Run from a SEPARATE machine against YOUR OWN
# server. Everything runs in Docker (run.sh). One real source IP.

# Your own server, everything before /api
TARGET_BASE_URL=https://api.ozak.dev
# A cheap public endpoint to hammer
ENDPOINT=/api/top-coins

# Flood rate and how long (DURATION capped at 600s)
REQUESTS_PER_SECOND=1000
DURATION=60

# Label for this run's report file (e.g. the phase)
PHASE_LABEL=without-fail2ban

# A server is "blocked" only after it stays unreachable this many seconds
BAN_CONFIRM_SECONDS=5
# TCP connect timeout (a connect timeout = firewall drop = blocked)
CONNECT_TIMEOUT=5
# Response read timeout (connected but no answer in time = slow, not blocked)
READ_TIMEOUT=15
# p95 above this (ms) is reported as degraded
DEGRADE_P95_MS=5000
# Status line every N seconds
MONITOR_EVERY=5
# Max requests in flight at once
MAX_INFLIGHT=3000

# Safety: refuse private/loopback targets. Only the local self-test sets this true.
ALLOW_LOCAL=false
