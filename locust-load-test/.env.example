# Same variable names as the k6 service (test/load-test/.env.example).

# ---- Target ----
# Everything before /api. Stage: https://api.ozak.dev
TARGET_BASE_URL=https://api.ozak.dev

# true = also hit the AI analysis APIs (fundamental, technical, whale, demo portfolio)
INCLUDE_AI_ANALYSIS=false

# ---- Mode ----
# load   = a fixed rate for DURATION
# stress = load keeps growing until the server fails (5xx or no response);
#          slow responses never stop it
TEST_MODE=stress

# ---- load mode ----
# Requests PER MINUTE (1000 = ~16.7 req/s). Each Locust user sends 1 req/s.
REQUESTS_PER_MINUTE=1000
# Optional: requests per second; overrides REQUESTS_PER_MINUTE when set
REQUESTS_PER_SECOND=
DURATION=2m

# ---- stress mode ----
# Step 1 sends STRESS_START_REQUESTS in STRESS_STEP_SECONDS; every next step adds
# STRESS_STEP_REQUESTS more (500, 1000, 1500 … per 10s = 50, 100, 150 … req/s).
# Stops ONLY when the server fails (5xx or no response) on more than
# CRITICAL_ERROR_RATE of a step's requests, or after STRESS_MAX_DURATION.
STRESS_START_REQUESTS=500
STRESS_STEP_REQUESTS=500
STRESS_STEP_SECONDS=10
STRESS_MAX_DURATION=30m

# ---- Stages (rated per step) ----
# 🟢 errors <= HEALTHY_ERROR_RATE and p95 <= HEALTHY_P95_MS
# 🔴 5xx or no response on more than CRITICAL_ERROR_RATE of requests (0 = the very first one)
# 🟡 anything in between
HEALTHY_ERROR_RATE=0.01
HEALTHY_P95_MS=2000
CRITICAL_ERROR_RATE=0.01

# ---- Load generator ----
# Max parallel users (normally users = req/s, each at <= 1 req/s)
MAX_VUS=5000
# Worker processes: -1 = one per CPU core
LOCUST_PROCESSES=-1
REQUEST_TIMEOUT=15s
AI_REQUEST_TIMEOUT=60s

# ---- Output ----
# Seconds between status lines in the terminal
MONITOR_EVERY=10
